# Copy to /etc/media-tracker/env (mode 600, owned by root) and fill in real values.
# These are the only configuration inputs; application.yaml inside the JAR references them.

# MariaDB 11.8 at the web host. sslMode=verify-full keeps credentials off the wire and validates the
# host certificate; use sslMode=trust instead if the host uses a self-signed certificate.
# timezone=UTC pins the session time zone; preserveInstants=true makes the driver bind java.sql.Timestamp
# values in that zone instead of the JVM's default, so stored timestamps are UTC regardless of the Pi's clock.
DB_URL=jdbc:mariadb://db.example.com:3306/mediatracker?sslMode=verify-full&timezone=UTC&preserveInstants=true
DB_USER=mediatracker
DB_PASSWORD=change-me

# HMAC key that signs the session-id cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Defaults: PORT=8080, SESSION_SECURE=true (cookie sent over HTTPS only; set false for plain-http LAN testing).
#PORT=8080
#SESSION_SECURE=true
