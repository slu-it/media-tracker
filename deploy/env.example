# Environment for both deployment paths (README "Deploy to the Pi"):
#   systemd:         EnvironmentFile=/etc/media-tracker/env   (deploy/media-tracker.service)
#   docker compose:  env_file: /etc/media-tracker/env         (deploy/docker-compose.yml)
# Copy to /etc/media-tracker/env (mode 600, owned by root) and fill in real values.
# Plain KEY=value lines, no `export`. Wrap a value in single quotes if it contains `$`, `#` or spaces; both
# systemd and compose strip the quotes, and only then do the two parsers agree on the value.
# These are the only configuration inputs; application.yaml inside the JAR references them.

# The central MariaDB 11.8 on the same Pi (deploy/database, decision record 0018). `mariadb` is its service
# name on the private pi-db network, which is why the app container has to join that network. The three
# values below are what `deploy/database/create-database.sh media-tracker` prints; by convention the
# password is the database name reversed.
# sslMode=disable is deliberate here: the connection never leaves the host, it runs over a Docker bridge,
# and the server has no certificate. (Decision record 0014 chose verify-full back when the database sat at
# a web host and the traffic crossed the internet.)
# timezone=UTC pins the session time zone; preserveInstants=true makes the driver bind java.sql.Timestamp
# values in that zone instead of the JVM's default, so stored timestamps are UTC regardless of the Pi's clock.
DB_URL=jdbc:mariadb://mariadb:3306/media-tracker?sslMode=disable&timezone=UTC&preserveInstants=true
DB_USER=media-tracker
DB_PASSWORD=rekcart-aidem
# For a password that is not derivable from the database name, provision with a generated one instead:
#   ./create-database.sh media-tracker "$(openssl rand -base64 24)"
# For the systemd path the application runs on the host and cannot resolve `mariadb`. Uncomment the
# published port in deploy/database/docker-compose.yml and use this instead:
#DB_URL=jdbc:mariadb://127.0.0.1:3306/media-tracker?sslMode=disable&timezone=UTC&preserveInstants=true

# HMAC key that signs the session-id cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Defaults: PORT=8080, SESSION_SECURE=true (cookie sent over HTTPS only; set false for plain-http LAN
# testing). With docker compose leave PORT at 8080 and change the host side of `ports:` instead.
#PORT=8080
#SESSION_SECURE=true

# Optional. SteamGridDB API key (free, from your profile at https://www.steamgriddb.com/profile/preferences/api).
# Enables the cover picker in the game detail dialog; without it the picker reports "not configured"
# (decision record 0024).
#STEAMGRIDDB_API_KEY=
