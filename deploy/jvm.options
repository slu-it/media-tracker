# Keep in sync with JAVA_TOOL_OPTIONS in the root Dockerfile (there the CDS archive is /tmp/media-tracker.jsa,
# the only writable path in the distroless image).
-Xmx192m
-XX:+UseSerialGC
-XX:TieredStopAtLevel=1
-XX:+AutoCreateSharedArchive
-XX:SharedArchiveFile=/opt/media-tracker/media-tracker.jsa
-Dfile.encoding=UTF-8
-Djava.security.egd=file:/dev/./urandom
