# Environment for deploy/database/docker-compose.yml (the central MariaDB, decision record 0018).
# Copy to `env` next to the compose file and fill in a real password:
#   sudo cp env.example env && sudo chmod 600 env
# Plain KEY=value lines, no `export`. Wrap a value in single quotes if it contains `$`, `#` or spaces.
#
# These variables are read only while the data directory is initialised, that is on the very first start
# with an empty ./data. Changing them afterwards has no effect on the running server; change the password
# with
#   sudo docker compose exec mariadb mariadb -uroot -p \
#     -e "ALTER USER 'root'@'localhost' IDENTIFIED BY 'new-password'"
# and keep this file in sync. create-database.sh and backup-database.sh read the password from the running
# container's environment, and a container keeps the environment it was created with, so after editing this
# file run `docker compose up -d` to recreate it -- `restart` is not enough.

# The administrative user. MariaDB's admin account is always called `root`; only its password can be set
# from the environment. Generate one with: openssl rand -base64 24
MARIADB_ROOT_PASSWORD=change-me

# Restricts root to connections from inside the container, i.e. the unix socket. create-database.sh and
# backup-database.sh reach it exactly that way through `docker compose exec`, so nothing is lost, and root
# cannot be used from the pi-db network or from a published port. Set to % only if you need to administer
# the server remotely, and then only together with a published port.
MARIADB_ROOT_HOST=localhost
