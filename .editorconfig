root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# ktlint follows IntelliJ's official Kotlin style (kotlin.code.style=official in gradle.properties).
ktlint_code_style = intellij_idea
# Off by default in ktlint 1.x (no type resolution, rare false positives); worth it for this code base.
ktlint_standard_no-unused-imports = enabled
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{ts,tsx,js,jsx,json,yaml,yml,html,css,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
